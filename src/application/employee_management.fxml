<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.EmployeeManagementController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #f0f4f8;">

    <VBox spacing="15" style="-fx-padding: 25;"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: #1a237e; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-cursor: hand;"/>
            <Label text="👷 Employee Management"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-text-fill: #1a237e;"/>
        </HBox>

        <!-- Add Employee Form -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;
                                   -fx-background-radius: 10;
                                   -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">
            <Label text="Add Employee"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <HBox spacing="10">
                <TextField fx:id="empUsernameField"
                           promptText="Username (existing user)"
                           prefWidth="200" style="-fx-padding: 8;"/>
                <ComboBox fx:id="roleCombo" prefWidth="150"
                          promptText="Select Role"/>
                <Button text="Add Employee" onAction="#handleAddEmployee"
                        style="-fx-background-color: #43a047;
                               -fx-text-fill: white; -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="formMessage" text=""
                   style="-fx-font-size: 12px;"/>
        </VBox>

        <!-- Employees Table -->
        <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEmpId"   text="Employee ID" prefWidth="150"/>
                <TableColumn fx:id="colEmpName" text="Name"        prefWidth="150"/>
                <TableColumn fx:id="colEmpUser" text="Username"    prefWidth="130"/>
                <TableColumn fx:id="colEmpRole" text="Role"        prefWidth="100"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="🗑 Remove Employee" onAction="#handleRemoveEmployee"
                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                           -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</AnchorPane>