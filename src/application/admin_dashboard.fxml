<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.AdminDashboardController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #f0f4f8;">

    <HBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Sidebar -->
        <VBox spacing="10" prefWidth="210"
              style="-fx-background-color: #1a237e; -fx-padding: 20;">

            <Label text="✈ AirlineMS"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label text="Admin Panel"
                   style="-fx-text-fill: #90caf9; -fx-font-size: 12px;"/>
            <Separator style="-fx-background-color: #3949ab;"/>

            <Button text="🏠  Dashboard"
                    onAction="#showDashboard" maxWidth="190"
                    style="-fx-background-color: #3949ab; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-padding: 10;
                           -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>

            <Button text="✈  Flight Management"
                    onAction="#showFlightManagement" maxWidth="190"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="👥  User Management"
                    onAction="#showUserManagement" maxWidth="190"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="👷  Employee Management"
                    onAction="#showEmployeeManagement" maxWidth="190"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="🎟  Coupon Management"
                    onAction="#showCouponManagement" maxWidth="190"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="📊  Reports"
                    onAction="#showReports" maxWidth="190"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="🎫  Book Flight (Admin)"
                    onAction="#showAdminBook" maxWidth="190"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Logout"
                    onAction="#handleLogout" maxWidth="190"
                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-padding: 10;
                           -fx-cursor: hand;"/>
        </VBox>

        <!-- Main Content Area -->
        <VBox spacing="20" HBox.hgrow="ALWAYS"
              style="-fx-padding: 30;">

            <Label text="Admin Dashboard"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: #1a237e;"/>

            <!-- Stats Cards -->
            <HBox spacing="20">
                <VBox alignment="CENTER" prefWidth="150" prefHeight="90"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">
                    <Label text="✈" style="-fx-font-size: 24px;"/>
                    <Label fx:id="totalFlightsLabel" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a237e;"/>
                    <Label text="Flights"
                           style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" prefHeight="90"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">
                    <Label text="👥" style="-fx-font-size: 24px;"/>
                    <Label fx:id="totalUsersLabel" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;
                                  -fx-text-fill: #43a047;"/>
                    <Label text="Users"
                           style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" prefHeight="90"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">
                    <Label text="🎫" style="-fx-font-size: 24px;"/>
                    <Label fx:id="totalBookingsLabel" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;
                                  -fx-text-fill: #ff8f00;"/>
                    <Label text="Bookings"
                           style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" prefHeight="90"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">
                    <Label text="💰" style="-fx-font-size: 24px;"/>
                    <Label fx:id="totalRevenueLabel" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;
                                  -fx-text-fill: #c62828;"/>
                    <Label text="Revenue(৳)"
                           style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- Recent Bookings -->
            <Label text="Recent Bookings"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <TableView fx:id="recentBookingsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colBId"     text="Booking ID"  prefWidth="140"/>
                    <TableColumn fx:id="colBUser"   text="User"        prefWidth="100"/>
                    <TableColumn fx:id="colBFlight" text="Flight"      prefWidth="80"/>
                    <TableColumn fx:id="colBFrom"   text="From"        prefWidth="90"/>
                    <TableColumn fx:id="colBTo"     text="To"          prefWidth="90"/>
                    <TableColumn fx:id="colBPrice"  text="Price(৳)"    prefWidth="80"/>
                    <TableColumn fx:id="colBStatus" text="Status"      prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</AnchorPane>