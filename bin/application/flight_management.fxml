<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.FlightManagementController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #f0f4f8;">

    <VBox spacing="15" style="-fx-padding: 25;"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: #1a237e; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-cursor: hand;"/>
            <Label text="✈ Flight Management"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-text-fill: #1a237e;"/>
        </HBox>

        <!-- Add Flight Form -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;
                                   -fx-background-radius: 10;
                                   -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">
            <Label text="Add New Flight"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <HBox spacing="10">
                <TextField fx:id="flightNoField" promptText="Flight No"
                           prefWidth="100" style="-fx-padding: 8;"/>
                <TextField fx:id="sourceField" promptText="From"
                           prefWidth="110" style="-fx-padding: 8;"/>
                <TextField fx:id="destField" promptText="To"
                           prefWidth="110" style="-fx-padding: 8;"/>
                <DatePicker fx:id="datePicker" prefWidth="140"/>
                <TextField fx:id="timeField" promptText="Time(HH:MM)"
                           prefWidth="100" style="-fx-padding: 8;"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="economyPriceField" promptText="Economy ৳"
                           prefWidth="110" style="-fx-padding: 8;"/>
                <TextField fx:id="businessPriceField" promptText="Business ৳"
                           prefWidth="110" style="-fx-padding: 8;"/>
                <TextField fx:id="firstPriceField" promptText="First ৳"
                           prefWidth="110" style="-fx-padding: 8;"/>
                <TextField fx:id="seatsField" promptText="Total Seats"
                           prefWidth="110" style="-fx-padding: 8;"/>
                <Button text="Add Flight" onAction="#handleAddFlight"
                        style="-fx-background-color: #43a047;
                               -fx-text-fill: white; -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="formMessage" text=""
                   style="-fx-font-size: 12px;"/>
        </VBox>

        <!-- Flights Table -->
        <TableView fx:id="flightsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNo"       text="Flight No"   prefWidth="90"/>
                <TableColumn fx:id="colFrom"     text="From"        prefWidth="100"/>
                <TableColumn fx:id="colTo"       text="To"          prefWidth="100"/>
                <TableColumn fx:id="colDate"     text="Date"        prefWidth="100"/>
                <TableColumn fx:id="colTime"     text="Time"        prefWidth="80"/>
                <TableColumn fx:id="colEconomy"  text="Economy(৳)"  prefWidth="95"/>
                <TableColumn fx:id="colBusiness" text="Business(৳)" prefWidth="95"/>
                <TableColumn fx:id="colFirst"    text="First(৳)"    prefWidth="85"/>
                <TableColumn fx:id="colSeats"    text="Seats"       prefWidth="70"/>
                <TableColumn fx:id="colStatus"   text="Status"      prefWidth="85"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="❌ Cancel Flight" onAction="#handleCancelFlight"
                    style="-fx-background-color: #c62828; -fx-text-fill: white;
                           -fx-padding: 10 20; -fx-cursor: hand;"/>
            <Button text="🗑 Delete Flight" onAction="#handleDeleteFlight"
                    style="-fx-background-color: #424242; -fx-text-fill: white;
                           -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</AnchorPane>