<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.PaymentController"
            prefHeight="650.0" prefWidth="620.0"
            style="-fx-background-color: #f0f4f8;">

    <ScrollPane fitToWidth="true"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                style="-fx-background-color: transparent;">

        <VBox spacing="15" style="-fx-padding: 30;">

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Back" onAction="#handleBack"
                        style="-fx-background-color: #1a237e;
                               -fx-text-fill: white;
                               -fx-padding: 8 15; -fx-cursor: hand;"/>
                <Label text="💳 Payment"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: #1a237e;"/>
            </HBox>

            <!-- Order Summary Box -->
            <VBox spacing="8"
                  style="-fx-background-color: #1a237e; -fx-padding: 15;
                         -fx-background-radius: 10;">
                <Label text="📋 Order Summary"
                       style="-fx-text-fill: white; -fx-font-weight: bold;
                              -fx-font-size: 14px;"/>
                <Label fx:id="summaryFlightLabel" text=""
                       style="-fx-text-fill: #90caf9; -fx-font-size: 13px;"/>
                <Label fx:id="summaryPassengerLabel" text=""
                       style="-fx-text-fill: #90caf9; -fx-font-size: 13px;"/>
                <Label fx:id="summarySeatLabel" text=""
                       style="-fx-text-fill: #90caf9; -fx-font-size: 13px;"/>
                <Separator style="-fx-background-color: #3949ab;"/>
                <Label fx:id="finalAmountLabel" text=""
                       style="-fx-text-fill: white; -fx-font-size: 20px;
                              -fx-font-weight: bold;"/>
            </VBox>

            <!-- Payment Method Selection -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-padding: 20;
                         -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">

                <Label text="Select Payment Method"
                       style="-fx-font-weight: bold; -fx-font-size: 15px;"/>

                <HBox spacing="15">
                    <RadioButton fx:id="bankRadio" text="🏦 Bank Account"
                                 onAction="#handlePaymentMethod"
                                 style="-fx-font-size: 13px;"/>
                    <RadioButton fx:id="cardRadio" text="💳 Card"
                                 onAction="#handlePaymentMethod"
                                 style="-fx-font-size: 13px;"/>
                    <RadioButton fx:id="bkashRadio" text="📱 Bkash"
                                 onAction="#handlePaymentMethod"
                                 style="-fx-font-size: 13px;"/>
                </HBox>

                <Separator/>

                <!-- Bank Fields -->
                <VBox fx:id="bankFields" spacing="10"
                      visible="false" managed="false">
                    <Label text="🏦 Bank Account Details"
                           style="-fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <Label text="Account Number"
                           style="-fx-font-weight: bold;"/>
                    <TextField fx:id="accountNumberField"
                               promptText="Enter account number"
                               style="-fx-padding: 10;"/>
                    <Label text="PIN" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="bankPinField"
                                   promptText="Enter 4-digit PIN"
                                   style="-fx-padding: 10;"/>
                </VBox>

                <!-- Card Fields -->
                <VBox fx:id="cardFields" spacing="10"
                      visible="false" managed="false">
                    <Label text="💳 Card Details"
                           style="-fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <Label text="Card Number"
                           style="-fx-font-weight: bold;"/>
                    <TextField fx:id="cardNumberField"
                               promptText="Enter 16-digit card number"
                               style="-fx-padding: 10;"/>
                    <Label text="PIN" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="cardPinField"
                                   promptText="Enter PIN"
                                   style="-fx-padding: 10;"/>
                </VBox>

                <!-- Bkash Fields -->
                <VBox fx:id="bkashFields" spacing="10"
                      visible="false" managed="false">
                    <Label text="📱 Bkash Details"
                           style="-fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <Label text="Bkash Number"
                           style="-fx-font-weight: bold;"/>
                    <TextField fx:id="bkashNumberField"
                               promptText="Enter Bkash number (01XXXXXXXXX)"
                               style="-fx-padding: 10;"/>
                    <Label text="PIN" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="bkashPinField"
                                   promptText="Enter PIN"
                                   style="-fx-padding: 10;"/>
                </VBox>
            </VBox>

            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: red; -fx-font-size: 12px;"/>

            <Button text="✅ Confirm Payment &amp; Get Ticket"
                    onAction="#handleConfirmPayment"
                    maxWidth="Infinity"
                    style="-fx-background-color: #43a047;
                           -fx-text-fill: white; -fx-font-size: 15px;
                           -fx-padding: 14; -fx-cursor: hand;"/>
        </VBox>
    </ScrollPane>
</AnchorPane>