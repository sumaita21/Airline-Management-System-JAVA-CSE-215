<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.SearchFlightController"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: #f0f4f8;">

    <VBox spacing="20" style="-fx-padding: 30;"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: #1a237e; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-cursor: hand;"/>
            <Label text="🔍 Search Available Flights"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-text-fill: #1a237e;"/>
        </HBox>

        <!-- Search Filters -->
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 20;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian,#ccc,5,0,0,2);">

            <VBox spacing="5">
                <Label text="From" style="-fx-font-weight: bold;"/>
                <TextField fx:id="fromField" promptText="e.g. Dhaka"
                           prefWidth="150" style="-fx-padding: 8;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="To" style="-fx-font-weight: bold;"/>
                <TextField fx:id="toField" promptText="e.g. Dubai"
                           prefWidth="150" style="-fx-padding: 8;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Date" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="datePicker" prefWidth="160"/>
            </VBox>

            <VBox spacing="5">
                <Label text=" "/>
                <Button text="Search" onAction="#handleSearch"
                        style="-fx-background-color: #1a237e; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </VBox>
            <VBox spacing="5">
                <Label text=" "/>
                <Button text="Show All" onAction="#handleShowAll"
                        style="-fx-background-color: #43a047; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </VBox>
        </HBox>

        <!-- Results Table -->
        <Label fx:id="resultLabel" text=""
               style="-fx-font-size: 13px; -fx-text-fill: gray;"/>

        <TableView fx:id="flightsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFlightNo"  text="Flight No"   prefWidth="100"/>
                <TableColumn fx:id="colFrom"      text="From"        prefWidth="110"/>
                <TableColumn fx:id="colTo"        text="To"          prefWidth="110"/>
                <TableColumn fx:id="colDate"      text="Date"        prefWidth="100"/>
                <TableColumn fx:id="colTime"      text="Time"        prefWidth="80"/>
                <TableColumn fx:id="colEconomy"   text="Economy(৳)"  prefWidth="100"/>
                <TableColumn fx:id="colBusiness"  text="Business(৳)" prefWidth="100"/>
                <TableColumn fx:id="colFirst"     text="First(৳)"    prefWidth="90"/>
                <TableColumn fx:id="colSeats"     text="Seats Left"  prefWidth="85"/>
            </columns>
        </TableView>

        <!-- Book Button -->
        <HBox alignment="CENTER_RIGHT">
            <Button text="Book Selected Flight ✈"
                    onAction="#handleBookFlight"
                    style="-fx-background-color: #1a237e; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-padding: 12 25;
                           -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</AnchorPane>