<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.StaffPassengersController"
            prefHeight="600.0" prefWidth="850.0"
            style="-fx-background-color: #f0f4f8;">

    <VBox spacing="15" style="-fx-padding: 25;"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: #1b5e20; -fx-text-fill: white;
                           -fx-padding: 8 15; -fx-cursor: hand;"/>
            <Label text="👥 Passenger Management"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-text-fill: #1b5e20;"/>
        </HBox>

        <HBox spacing="10">
            <TextField fx:id="searchField"
                       promptText="Search by name or booking ID..."
                       prefWidth="300" style="-fx-padding: 8;"/>
            <Button text="Search" onAction="#handleSearch"
                    style="-fx-background-color: #1b5e20; -fx-text-fill: white;
                           -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="Show All" onAction="#handleShowAll"
                    style="-fx-background-color: #43a047; -fx-text-fill: white;
                           -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="passengersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBId"    text="Booking ID"     prefWidth="140"/>
                <TableColumn fx:id="colName"   text="Passenger Name" prefWidth="150"/>
                <TableColumn fx:id="colFlight" text="Flight"         prefWidth="90"/>
                <TableColumn fx:id="colFrom"   text="From"           prefWidth="100"/>
                <TableColumn fx:id="colTo"     text="To"             prefWidth="100"/>
                <TableColumn fx:id="colSeat"   text="Seat"           prefWidth="70"/>
                <TableColumn fx:id="colClass"  text="Class"          prefWidth="85"/>
                <TableColumn fx:id="colStatus" text="Status"         prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>